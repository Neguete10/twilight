# Finder window for the desktop Twilight disk image.
# scripts/generate-dmg.sh sources this file and passes the values to create-dmg.
# scripts/make_dmg_background.py reads the same values and draws the arrow
# between Twilight.app and the Applications alias. Change a coordinate here,
# then regenerate the PNGs. See the docstring in that script.
DMG_VOLNAME="Twilight"
DMG_WINDOW_X=200
DMG_WINDOW_Y=120
DMG_WINDOW_W=660
DMG_WINDOW_H=400
DMG_ICON_SIZE=128
DMG_TEXT_SIZE=13
DMG_APP_X=170
DMG_APP_Y=160
DMG_APPLICATIONS_X=490
DMG_APPLICATIONS_Y=160
DMG_CAPTION="Drag Twilight.app into Applications"
