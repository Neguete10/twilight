<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.developer.spatial-audio.profile-access</key>
	<true/>
	<key>com.apple.developer.coremotion.head-pose</key>
	<true/>
	<!-- Hardened Runtime: lets the CoreHID/IOHID mouse path request Input Monitoring.
	     App Sandbox can still deny it; the client falls back to SDL. Not used by the MAS plist. -->
	<key>com.apple.security.device.input-monitoring</key>
	<true/>
</dict>
</plist>
